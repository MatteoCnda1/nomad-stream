# Copiez ce fichier en server/.env et renseignez vos valeurs.
# server/.env est ignoré par git (ne jamais committer de token).

# --- Plex (obligatoire) ---
PLEX_URL=http://192.168.1.81:32400
PLEX_TOKEN=votre_token_plex_ici

# --- Serveur (optionnel) ---
# HOST=0.0.0.0        # 127.0.0.1 pour n'exposer que via `tailscale serve`
# PORT=3000
# PLEX_TIMEOUT_MS=15000   # délai max d'une requête de métadonnées ou d'image vers Plex
# NOMAD_CACHE_DIR=/var/cache/nomad   # tous les caches (vignettes, iGPU, hors ligne) ; défaut : server/.cache
# NOMAD_IMAGE_CACHE_MB=500           # plafond du cache de vignettes (les moins récemment servies partent)
# NOMAD_LOG_DIR=                     # journal des lectures (playback.jsonl) ; défaut : NOMAD_CACHE_DIR/logs
# NOMAD_IMAGE_CONCURRENCY=4          # vignettes transcodées en même temps par Plex
# NOMAD_SEARCH_TTL_MIN=15            # âge maximal de l'index de recherche (reconstruit en arrière-plan)

# --- Authentification (optionnel) ---
# Définir ACCESS_CODE active une porte d'entrée par code partagé.
# Laisser vide = aucune auth (accès libre dans le tailnet, comportement d'origine).
# ACCESS_CODE=choisis-un-code
# SESSION_SECRET=    # facultatif ; si vide, dérivé du code automatiquement

# --- Transcodage iGPU : passerelle maison uniquement (sinon laisser vide) ---
# NOMAD_TRANSCODER=vaapi
# VAAPI_DEVICE=/dev/dri/renderD128
# LIBVA_DRIVER_NAME=iHD
# NOMAD_MEDIA_MAP=/media=/media
